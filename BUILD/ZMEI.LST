      1				     ; UDAV -- DOS .COM	snake game, TASM/MASM syntax (8086 instructions).
      2				     ; Build: TASM /l ZMEI.ASM	 then	TLINK /t ZMEI.OBJ
      3				     ;
      4				     ; Mode 13h	has 320x200 pixels. Each game cell occupies 2x2	pixels,
      5				     ; so positions are	packed as AH = cell row	(0..99), AL = column (0..159).
      6				     ; The bitmap's palette indices are	also the game's	collision/food map.
      7
      8	0000			     .model tiny
      9	0000			     .code
     10				     org 100h
     11
     12	      =	00A0		     BOARD_COLUMNS	 equ 160
     13	      =	0064		     BOARD_ROWS		 equ 100
     14	      =	0140		     SCREEN_WIDTH	 equ 320
     15	      =	A000		     VGA_SEGMENT	 equ 0A000h
     16	      =	0436		     BITMAP_HEADER_SIZE	 equ 1078	; 14 + 40 bytes	+ 256 four-byte	colors
     17	      =	3E80		     BITMAP_PIXEL_COUNT	 equ BOARD_COLUMNS * BOARD_ROWS
     18	      =	42B6		     BITMAP_FILE_SIZE	 equ BITMAP_HEADER_SIZE	+ BITMAP_PIXEL_COUNT
     19	      =	0400		     MAX_SNAKE_LENGTH	 equ 1024
     20	      =	0002		     MIN_SNAKE_LENGTH	 equ 2
     21	      =	0004		     INITIAL_LENGTH	 equ 4
     22	      =	0004		     LAST_LEVEL		 equ 4
     23
     24	      =	0000		     COLOR_BACKGROUND	 equ 0
     25	      =	0002		     COLOR_APPLE	 equ 2		; grow by one segment
     26	      =	0003		     COLOR_SHRINK	 equ 3		; discard tail as a green apple
     27	      =	0004		     COLOR_DOUBLE_APPLE	 equ 4		; grow by two segments
     28	      =	000F		     COLOR_SOLID	 equ 15		; walls	and snake share	this color
     29
     30	      =	0001		     DIR_LEFT		 equ 1
     31	      =	0002		     DIR_UP		 equ 2
     32	      =	0003		     DIR_RIGHT		 equ 3
     33	      =	0004		     DIR_DOWN		 equ 4
     34	      =	0000		     STEP_ALIVE		 equ 0
     35	      =	0001		     STEP_DEAD		 equ 1
     36	      =	0002		     STEP_COMPLETE	 equ 2
     37
     38	      =	0001		     SCAN_ESCAPE	 equ 01h
     39	      =	003B		     SCAN_F1		 equ 3Bh
     40	      =	003C		     SCAN_F2		 equ 3Ch
     41	      =	0044		     SCAN_F10		 equ 44h
     42	      =	0048		     SCAN_UP		 equ 48h
     43	      =	004B		     SCAN_LEFT		 equ 4Bh
     44	      =	004D		     SCAN_RIGHT		 equ 4Dh
     45	      =	0050		     SCAN_DOWN		 equ 50h
     46
     47	0100			     startup proc near
