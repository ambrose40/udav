    247	0291  C7 06 04C2r 0000		 mov food_remaining,0
    248	0297  BE 118Dr			 mov si,offset bitmap_buffer + BITMAP_HEADER_SIZE
    249	029A  33 DB			 xor bx,bx			 ; BH =	row, BL	= column
    250	029C			     draw_bitmap_cell:
