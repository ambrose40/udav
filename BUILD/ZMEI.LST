    214	0244  75 49			 jne bitmap_invalid
    215	0246  83 3E 0D65r 28		 cmp word ptr bitmap_buffer[14],40
    216	024B  75 42			 jne bitmap_invalid
    217	024D  83 3E 0D67r 00		 cmp word ptr bitmap_buffer[16],0
