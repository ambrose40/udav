    209	022F  81 3E 0D57r 4D42		 cmp word ptr bitmap_buffer[0],4D42h ; "BM"
    210	0235  75 58			 jne bitmap_invalid
    211	0237  81 3E 0D61r 0436		 cmp word ptr bitmap_buffer[10],BITMAP_HEADER_SIZE
    212	023D  75 50			 jne bitmap_invalid
