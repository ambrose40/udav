    194	0214  8B D8			 mov bx,ax
    195	0216  BA 0D57r			 mov dx,offset bitmap_buffer
    196	0219  B9 42B6			 mov cx,BITMAP_FILE_SIZE
    197	021C  B4 3F			 mov ah,3Fh
    198	021E  CD 21			 int 21h
    199					 ; Preserve both the read result and carry across DOS close.
    200	0220  9C			 pushf
    201	0221  50			 push ax
    202	0222  B4 3E			 mov ah,3Eh
    203	0224  CD 21			 int 21h
    204	0226  58			 pop ax
    205	0227  9D			 popf
    206	0228  72 66			 jc bitmap_open_failed
    207	022A  3D 42B6			 cmp ax,BITMAP_FILE_SIZE
