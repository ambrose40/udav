    184				     ; Load one	of the supplied	160x100, uncompressed, 8-bit BMPs.
    185				     ; In: DS:DX = ASCIIZ filename. Out: CF set	on open/read/format failure.
    186				     ; Clobbers	AX/BX/CX/DX/SI.	Always closes an opened	handle.
    187				     ; The artwork deliberately	uses file-row order as screen-row order, just as
    188				     ; the original game did; do not reverse the usual bottom-up BMP scanlines.
    189	0209			     load_bitmap proc near
    190	0209  89 16 04C6r		 mov current_filename,dx
    191	020D  B8 3D00			 mov ax,3D00h
